[
  {
    "id": "history_show_on_focus",
    "description": "Show 5 most recent searches on focus",
    "initial_state": {"localStorage": ["a","b","c","d","e","f"]},
    "actions": [{"action": "focus"}],
    "expected": {"dropdown": true, "items": ["f","e","d","c","b"]}
  },
  {
    "id": "dedupe_and_order",
    "description": "Repeated search moves to front and dedupes",
    "initial_state": {"localStorage": ["x","y","z"]},
    "actions": [{"action": "type","text":"y"},{"action":"enter"}],
    "expected": {"items": ["y","x","z"]}
  },
  {
    "id": "malformed_entries",
    "description": "Non-string and long strings in storage are handled gracefully",
    "initial_state": {"localStorage": ["ok", null, 123, ""]},
    "actions": [{"action":"focus"}],
    "expected": {"items_contains": ["ok","aaaaa"], "no_crash": true}
  },
  {
    "id": "persistence_and_opt_out",
    "description": "History persists across reloads; opt-out disables persistence",
    "initial_state": {"localStorage": []},
    "actions": [{"action":"type","text":"taco"},{"action":"enter"},{"action":"reload"},{"action":"focus"}],
    "expected": {"persistence": true}
  },
  {
    "id": "clear_history_button",
    "description": "Clear history removes entries from dropdown and localStorage",
    "initial_state": {"localStorage": ["x","y","z"]},
    "actions": [{"action":"focus"},{"action":"click","selector":"#clearHistory"},{"action":"focus"}],
    "expected": {"items": []}
  },
  {
    "id": "opt_out_disables_persistence",
    "description": "Checking opt-out prevents saving searches",
    "initial_state": {"localStorage": []},
    "actions": [{"action":"click","selector":"#optOut"},{"action":"type","text":"donot"},{"action":"enter"},{"action":"reload"},{"action":"focus"}],
    "expected": {"persistence": false}
  },
  {
    "id": "keyboard_navigation",
    "description": "Up/Down arrow navigates and Enter selects item, Esc closes",
    "initial_state": {"localStorage": ["alpha","beta","gamma"]},
    "actions": [{"action":"focus"},{"action":"key","key":"ArrowDown"},{"action":"key","key":"ArrowDown"},{"action":"key","key":"Enter"}],
    "expected": {"search_payload":"beta", "aria_selected": true}
  }
]
