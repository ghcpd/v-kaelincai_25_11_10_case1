    "actions": [
      {"action": "type", "text": "sushi"},
      {"action": "enter"}
    ],
    "expected": {"search_payload": "sushi"}
  },
  {
    "id": "baseline_persistence_absence",
    "description": "Baseline has no history persistence",
    "initial_state": {"localStorage": {}},
    "actions": [
      {"action": "type", "text": "burrito"},
      {"action": "enter"},
      {"action": "reload"}
    ],
    "expected": {"no_history_key": true}
