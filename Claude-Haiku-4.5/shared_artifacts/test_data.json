          "delay_ms": 0
        },
        {
          "action": "key_press",
          "target": "search_input",
          "key": "ArrowDown",
          "delay_ms": 100
        },
        {
          "action": "key_press",
          "target": "search_input",
          "key": "ArrowDown",
          "delay_ms": 100
        },
        {
          "action": "key_press",
