        "items_count": 5,
        "search_triggered": true,
        "search_payload": {
          "query": "react hooks",
          "method": "GET",
          "timestamp_present": true
        },
        "storage_state": [
          "python tutorial",
          "javascript async",
          "database optimization",
          "rest api design",
          "css grid layout",
          "react hooks"
        ]
      },
      "acceptance_criteria": {
        "search_triggered_on_enter": true,
        "new_entry_added_to_history": true,
        "persisted_correctly": true,
        "most_recent_displayed_first": true,
        "max_5_shown_oldest_dropped": true
      }
    },
