    {
      "id": "TC_009_malformed_input_xss",
      "title": "Robustness - Malformed Input / XSS Prevention",
      "description": "History contains HTML/script tags, special chars; system sanitizes and displays safely without executing",
      "category": "robustness",
      "initial_state": {
        "history": [
          "<script>alert('xss')</script>",
          "search & special chars <div>",
          "unicode test: 你好世界",
          "null character with control",
          "very long string with many x characters (500+ chars)"
        ],
        "persistence_enabled": true,
        "opt_out": false
      },
      "user_actions": [
        {
          "action": "focus",
          "target": "search_input",
          "delay_ms": 0
        },
        {
          "action": "wait",
          "delay_ms": 200
        }
      ],
      "expected_output": {
        "dropdown_visible": true,
        "dropdown_items_safe": [
          "&lt;script&gt;alert(&#39;xss&#39;)&lt;/script&gt;",
          "search &amp; special chars &lt;div&gt;",
          "unicode test: 你好世界",
          "null character with control",
          "very long string with many x characters (500+ chars)"
        ],
        "no_script_execution": true,
        "no_dom_injection": true,
        "safe_rendering": true
      },
      "acceptance_criteria": {
        "html_tags_escaped": true,
        "no_script_execution": true,
        "special_chars_safe": true,
        "long_strings_handled": true,
        "unicode_preserved": true
      }
    },
