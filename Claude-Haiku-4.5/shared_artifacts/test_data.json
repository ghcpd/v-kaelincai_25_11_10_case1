    {
      "id": "TC_007_persistence_across_reload",
      "title": "Persistence - History Survives Page Reload",
      "description": "User performs searches, reloads page, history is restored from storage",
      "category": "persistence",
      "initial_state": {
        "history": [],
        "persistence_enabled": true,
        "opt_out": false
      },
      "user_actions": [
        {
          "action": "type",
          "target": "search_input",
          "text": "first search",
          "delay_ms": 0
        },
        {
          "action": "key_press",
          "target": "search_input",
          "key": "Enter",
          "delay_ms": 0
        },
        {
          "action": "wait",
          "delay_ms": 300
        },
        {
          "action": "type",
          "target": "search_input",
          "text": "second search",
          "delay_ms": 0
        },
        {
          "action": "key_press",
          "target": "search_input",
          "key": "Enter",
          "delay_ms": 0
        },
        {
          "action": "wait",
          "delay_ms": 300
        },
        {
          "action": "reload_page",
          "delay_ms": 0
        },
        {
          "action": "wait",
          "delay_ms": 500
        },
        {
          "action": "focus",
          "target": "search_input",
          "delay_ms": 0
        }
      ],
      "expected_output": {
        "history_before_reload": [
          "first search",
          "second search"
        ],
        "history_after_reload": [
          "second search",
          "first search"
        ],
        "dropdown_visible": true,
        "dropdown_items": [
          "second search",
          "first search"
        ],
        "persistence_verified": true
      },
      "acceptance_criteria": {
        "history_persists_across_reload": true,
        "order_maintained": true,
        "no_data_loss": true,
        "storage_mechanism_working": true
      }
    },
