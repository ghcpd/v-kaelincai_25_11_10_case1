{
  "test_cases": [
    {
      "id": "TC_001_empty_history",
      "title": "Empty History - Normal Case",
      "description": "User with no prior searches focuses input field; dropdown should be hidden or show empty state",
      "category": "normal",
      "initial_state": {
        "history": [],
        "persistence_enabled": true,
        "opt_out": false
      },
      "user_actions": [
        {
          "action": "focus",
          "target": "search_input",
          "delay_ms": 0
        }
      ],
      "expected_output": {
        "dropdown_visible": false,
        "dropdown_items": [],
        "search_triggered": false,
        "storage_state": []
      },
      "acceptance_criteria": {
        "dropdown_hidden_on_empty": true,
        "no_search_on_focus": true
      }
    },
    {
      "id": "TC_002_normal_history_display",
      "title": "Normal Case - History Display on Focus",
      "description": "User with 5 prior searches focuses input; dropdown displays up to 5 items in most-recent-first order",
      "category": "normal",
      "initial_state": {
        "history": [
          "python tutorial",
          "javascript async",
          "database optimization",
          "rest api design",
          "css grid layout"
        ],
        "persistence_enabled": true,
        "opt_out": false
      },
      "user_actions": [
        {
          "action": "focus",
          "target": "search_input",
          "delay_ms": 0
        }
      ],
      "expected_output": {
        "dropdown_visible": true,
        "dropdown_items": [
          "css grid layout",
          "rest api design",
          "database optimization",
          "javascript async",
          "python tutorial"
        ],
        "items_count": 5,
        "search_triggered": false,
        "storage_state": [
          "python tutorial",
          "javascript async",
          "database optimization",
          "rest api design",
          "css grid layout"
        ]
      },
      "acceptance_criteria": {
        "dropdown_visible_on_focus": true,
        "max_5_items_displayed": true,
        "most_recent_first_order": true,
        "no_search_triggered_on_focus": true
      }
    },
    {
      "id": "TC_003_new_search_added",
      "title": "Normal Case - New Search Added to History",
      "description": "User types query and presses Enter; new entry added to history, persisted, and dropdown refreshed on next focus",
      "category": "normal",
      "initial_state": {
        "history": [
          "python tutorial",
          "javascript async",
          "database optimization",
          "rest api design",
          "css grid layout"
        ],
        "persistence_enabled": true,
        "opt_out": false
      },
      "user_actions": [
        {
          "action": "type",
          "target": "search_input",
          "text": "react hooks",
          "delay_ms": 0
        },
        {
          "action": "key_press",
          "target": "search_input",
          "key": "Enter",
          "delay_ms": 0
        },
        {
          "action": "wait",
          "delay_ms": 500
        },
        {
          "action": "focus",
          "target": "search_input",
          "delay_ms": 0
        }
      ],
      "expected_output": {
        "dropdown_visible": true,
        "dropdown_items": [
          "react hooks",
          "css grid layout",
          "rest api design",
          "database optimization",
          "javascript async"
